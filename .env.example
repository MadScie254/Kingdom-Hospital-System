# Copy to .env.local for local development. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# At least 32 random characters, for example: openssl rand -hex 32
AUTH_SECRET=
# Optional. The public address used in links inside emails, no trailing slash.
APP_ORIGIN=
# Local testing only: lets Settings, Email accept a relay that is not on script.google.com. Never set this in production.
MAIL_RELAY_ALLOW_ANY=
# A random string that protects the backup endpoint. For example: openssl rand -hex 32
CRON_SECRET=

# SHA through the DHA Health Information Exchange. Optional until DHA issues credentials.
# In production set these three as Worker secrets (npx wrangler secret put NAME). Never commit real values.
DHA_BASE_URL=https://ilm-dev.dha.go.ke/uat-middleware/api/v1
DHA_CLIENT_ID=
DHA_CLIENT_SECRET=
# Set to off if DHA issues credentials that already carry the facility. Otherwise the facility FR code from Settings is sent with each request.
DHA_FACILITY_HEADERS=
# Terminology service. These defaults are DHA's.
DHA_TERMINOLOGY_OWNER=ORG-00002
DHA_INTERVENTIONS_SOURCE=BenefitsAndInterventions
# The ICD-11 source id in the DHA terminology service. Leave empty to type ICD-11 codes by hand.
DHA_ICD11_SOURCE=
# A long random string. SHA posts status updates to /api/hie/callback/<this value>. Leave empty to turn updates off.
DHA_CALLBACK_SECRET=
